# Copy this file to .env and fill in your keys.

# Swarms API key: every agent runs on the Swarms API.
# Get one at https://swarms.world/platform/api-keys
SWARMS_API_KEY="your_swarms_api_key_here"

# Exa API key: the search subagents search the web with Exa.
# Get one at https://dashboard.exa.ai/api-keys
EXA_API_KEY="your_exa_api_key_here"

# Optional API base URLs
# SWARMS_BASE_URL="https://api.swarms.world"
# EXA_BASE_URL="https://api.exa.ai"

# Models and token limits are set on AdvancedResearch(...), for example:
#   AdvancedResearch(
#       director_model_name="gpt-5.5",
#       worker_model_name="gpt-5.4-mini",
#       director_max_tokens=4000,
#       worker_max_tokens=3000,
#   )
# Any model from GET https://api.swarms.world/v1/models/available works.
# Note: a Swarms API request ends after 30 seconds. Slow models with a high
# max_tokens can hit that limit on the report step; the defaults stay under it.
